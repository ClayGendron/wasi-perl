diff --git a/recipes/cpan-extensions b/recipes/cpan-extensions
new file mode 100644
index 0000000..1d452ee
--- /dev/null
+++ b/recipes/cpan-extensions
@@ -0,0 +1,7 @@
+# XS distributions from CPAN, linked statically like the core's own. Each line: the tarball
+# (pinned in downloads/SHA256SUMS) and the folder under cpan/ it is unpacked as, which is the
+# module name with "::" as "-", so Perl's make_ext.pl finds it from the static_ext entry.
+Cpanel-JSON-XS-4.83.tar.gz Cpanel-JSON-XS
+Text-CSV_XS-1.65.tgz Text-CSV_XS
+Sort-Key-1.33.tar.gz Sort-Key
+YAML-LibYAML-v0.910.0.tar.gz YAML-XS-LibYAML
diff --git a/scripts/20_target.sh b/scripts/20_target.sh
index 4e101b7..acb64cc 100755
--- a/scripts/20_target.sh
+++ b/scripts/20_target.sh
@@ -50,6 +50,22 @@ if [ -d "$PATCHES" ]; then
         run "$LOG" patch -p1 -i "$p"
     done
 fi
+# XS distributions from CPAN join the tree under cpan/, so make_ext.pl builds them like the core's
+# own static extensions. Each tarball is checked against its pin before it is unpacked.
+grep -v '^#' "$ROOT/recipes/cpan-extensions" | while read -r tarball folder; do
+    [ -n "$tarball" ] || continue
+    sum=$(grep " $tarball " "$DOWNLOADS/SHA256SUMS" | cut -d' ' -f1)
+    [ -n "$sum" ] || fail "$tarball is not pinned in downloads/SHA256SUMS"
+    echo "$sum  $DOWNLOADS/$tarball" | sha256sum -c --status || fail "$tarball does not match downloads/SHA256SUMS"
+    rm -rf "$BUILD/unpack-cpan"
+    mkdir -p "$BUILD/unpack-cpan"
+    run "$LOG" tar -C "$BUILD/unpack-cpan" --no-same-owner -xzf "$DOWNLOADS/$tarball"
+    set -- "$BUILD/unpack-cpan"/*
+    [ $# -eq 1 ] && [ -d "$1" ] || fail "$tarball did not unpack to one folder"
+    [ ! -e "cpan/$folder" ] || fail "cpan/$folder already exists in the Perl tree"
+    mv "$1" "cpan/$folder"
+    rmdir "$BUILD/unpack-cpan"
+done
 
 sed -e "s|@ROOT@|$ROOT|g" -e "s|@BUILD@|$BUILD|g" -e "s|@SDK@|$SDK|g" -e "s|@SYSROOT@|$SYSROOT|g" \
     -e "s|@NATIVE@|$NATIVE|g" -e "s|@NATIVEPERL@|$BUILD/native-install/bin/perl|g" \
