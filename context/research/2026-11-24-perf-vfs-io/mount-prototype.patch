+# The linker: wasmtime's WASI plus one shadow per call above, defined once per engine. Each
+# shadow serves the table of the call running on its thread.
+
+_current = threading.local()
+_linkers: dict[tuple[int, tuple[str, ...]], Any] = {}
+_trampolines: dict[tuple[int, tuple[tuple[str, tuple[str, ...]], ...]], Any] = {}
+_lock = threading.Lock()
+
+
+def _shadow(name: str) -> Callable[..., int]:
+    def function(caller: Any, *args: int) -> int:
+        table: Table = _current.table
+        observer = table.observer
+        if observer is None:
+            return table.serve(name, caller, args)
+        return observer(name, caller, args, lambda: table.serve(name, caller, args))
+
+    return function
+
+
+def linker(wt: Any, engine: Any, signatures: dict[str, tuple[str, ...]]) -> Any:
+    """wasmtime's WASI with a shadow over each call in `signatures`, once per engine."""
+    key = (id(engine), tuple(signatures))
+    with _lock:
+        found = _linkers.get(key)
+        if found is None:
+            found = wt.Linker(engine)
+            found.define_wasi()
+            found.allow_shadowing = True
+            kinds = {"i32": wt.ValType.i32(), "i64": wt.ValType.i64()}
+            for name, params in signatures.items():
+                ty = wt.FuncType([kinds[p] for p in params], [kinds["i32"]])
+                found.define_func("wasi_snapshot_preview1", name, ty, _shadow(name), True)
+            _linkers[key] = found
+        return found
+
+
+def _trampoline_wat(signatures: dict[str, tuple[str, ...]]) -> str:
+    lines = ["(module"]
+    for name, params in signatures.items():
+        sig = f"(param {' '.join(params)}) (result i32)"
+        lines.append(f'  (import "wasi_snapshot_preview1" "{name}" (func ${name} {sig}))')
+    lines.append('  (import "env" "memory" (memory 0))')
+    lines.append('  (export "memory" (memory 0))')
+    for name, params in signatures.items():
+        sig = f"(param {' '.join(params)}) (result i32)"
+        gets = " ".join(f"(local.get {i})" for i in range(len(params)))
+        lines.append(f'  (func (export "{name}") {sig} (call ${name} {gets}))')
+    lines.append(")")
+    return "\n".join(lines)
+
+
+def bind(
+    wt: Any,
+    store: Any,
+    engine: Any,
+    table: Table,
+    instance: Any,
+    signatures: dict[str, tuple[str, ...]],
+) -> None:
+    """The trampoline on the guest's memory, after the guest is instantiated and before it
+    runs: each forward reaches wasmtime's own call through it, so that call reads and writes
+    the guest's memory."""
+    from wasi_perl import _wasmtime_ffi
