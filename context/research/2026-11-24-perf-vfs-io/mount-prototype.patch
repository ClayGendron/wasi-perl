+
+def _open_writing(t: Table, mounted: _Mounted, path: str, oflags: int) -> _Open | int:
+    creat, excl, trunc = oflags & O_CREAT, oflags & O_EXCL, oflags & O_TRUNC
+    mount = mounted.mount
+    data: bytes | bytearray = bytearray()
+    if creat and (excl or trunc):
+        st = t.stat(mounted, path)
+        if not isinstance(st, int):
+            if excl:
+                return EEXIST
+            if st.kind == "dir":
+                return EISDIR
+        elif st != ENOENT:
+            return st
+        missing = isinstance(st, int)
+        entry = _Open(mounted, path, "file", data=bytearray(), writable=True)
+        if mount.defer_create:
+            entry.dirty = True
+            mounted.pending[path] = entry
+            if mount.memo:
+                mounted.stats.pop(path, None)
+            return entry
+        if errno := t._change(mounted, "write", path, b""):
+            return errno
+        t._forget(mounted, path)
+        if missing and mount.memo:
+            mounted.stats[path] = Stat("file", 0)
+        return entry
+    body = t._read(mounted, path)
+    if body == ENOENT and creat:
+        entry = _Open(mounted, path, "file", data=bytearray(), writable=True, dirty=True)
+        if mount.defer_create:
+            mounted.pending[path] = entry
+            return entry
+        if errno := t._change(mounted, "write", path, b""):
+            return errno
+        entry.dirty = False
+        return entry
+    if isinstance(body, int):
+        return body
+    data = bytearray(b"" if trunc else body)
+    entry = _Open(mounted, path, "file", data=data, writable=True, dirty=bool(trunc))
+    return entry
