+    key = (id(engine), tuple(signatures.items()))
+    with _lock:
+        module = _trampolines.get(key)
+        if module is None:
+            module = _trampolines[key] = wt.Module(engine, _trampoline_wat(signatures))
+    plain = wt.Linker(engine)
+    plain.define_wasi()
+    imports = [plain.get(store, "wasi_snapshot_preview1", name) for name in signatures]
+    imports.append(instance.exports(store)["memory"])
+    exports = wt.Instance(store, module, imports).exports(store)
+    table.forwards = {
+        name: _wasmtime_ffi.Forward(exports[name], signatures[name]) for name in signatures
