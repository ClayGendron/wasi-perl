+"""Mounts: a provider's files at a guest path, served from embedder code. A research prototype.
+
+    from wasi_perl import run
+    from wasi_perl._mounts import Mount
+
+    done = run(["-ne", "print if /x/", "/work/a.txt"], mounts=[Mount(files, "/work")])
+
+Adapted from wasi-python's `mounts.py`, `_fs_table.py`, `_fs_descriptors.py`, `_fs_paths.py`,
+`_fs_memory.py` and `_wasmtime_ffi.py` (same owner, Apache-2.0): the same provider protocol
+(`stat`, `list` and `read`, and `write`, `mkdir`, `remove`, `rmdir` and `rename` for a writable
+mount, on normalized paths), whole-file staging, provider numbers from 2**30 and a trampoline
+that forwards every other descriptor to wasmtime's own WASI. Trimmed hard: no ABI checks of
+flags, no budgets, no faults record, no thread hand-off. It exists to count and time the calls a
+Perl program makes through a mount; it is not the shape a specification would ship.
+
+What the guest sees: each mount is preopened on an empty, read-only folder the runner owns, so
+wasi-libc's scan of preopens and the guest's descriptor table find it at its guest path. A
+shadow over each descriptor call answers the mount's numbers here and forwards the rest.
+
+Three choices go beyond wasi-python's, each named by a `Mount` field so that a measurement can
+turn it off:
+
+- `defer_create`: a file the guest creates exists in this call's own view until its close, and
+  reaches the provider as one `write` then, not a `write(path, b"")` at open and a second at
+  close. A rename or removal of such a file before its close makes no provider call.
+- `memo`: within one call, a `stat` answer and a staged body are kept by path and reused, and
+  the call's own writes update them. A `list` answer fills the memo with each entry's kind.
+- `stat_reads`: a `stat` of a file is answered by one `read`, whose bytes are kept for the next
+  open of that path. The guest's descriptor table looks at every path before it opens it (to
+  refuse special files), so without this an open costs a `stat` and a `read`.
+- `defer_close`: a file created in this call and closed is written back at the call's end, not
+  at its close, under the name it has then. `-pi` writes a temporary file, closes it and renames
+  it over the original; with this the provider sees one `write` of the original and no rename.
+  The price: a refused write-back reaches the guest at no close, only the call's record.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import enum
+import stat as _stat
+import struct
+import tempfile
+import threading
+from collections.abc import Callable, Iterable
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+# The numbers are preview1's (wasi-libc's wasip1.h).
+EBADF, EEXIST, EINVAL, EIO, EISDIR = 8, 20, 28, 29, 31
+ENOENT, ENOTDIR, ENOTEMPTY, ENOTSUP, EPERM, EROFS, EXDEV = 44, 54, 55, 58, 63, 69, 75
+ENOTCAPABLE, ESPIPE = 76, 70
+DIRECTORY, REGULAR_FILE = 3, 4
+O_CREAT, O_DIRECTORY, O_EXCL, O_TRUNC = 1, 2, 4, 8
+APPEND = 1
+FD_WRITE = 1 << 6
+RIGHTS = (1 << 30) - 1
+PROVIDER_BASE = 2**30
+FILESTAT = "<QQB7xQQQQQ"  # dev, ino, filetype, nlink, size, atim, mtim, ctim: 64 bytes
+FDSTAT = "<BxH4xQQ"  # filetype, flags, rights base and inheriting: 24 bytes
+DIRENT = "<QQIB3x"  # d_next, d_ino, d_namlen, d_type: 24 bytes
+METHODS = ("stat", "list", "read", "write", "mkdir", "remove", "rmdir", "rename")
+
+# The calls a descriptor of a mount can reach, each with its raw parameters (the result is one
+# i32). perl.wasm imports 22 of them; the other four are shadowed so that no later binary
+# reaches a mount's number unseen.
+SIGNATURES: dict[str, tuple[str, ...]] = {
+    "fd_advise": ("i32", "i64", "i64", "i32"),
+    "fd_close": ("i32",),
+    "fd_datasync": ("i32",),
+    "fd_fdstat_get": ("i32", "i32"),
+    "fd_fdstat_set_flags": ("i32", "i32"),
+    "fd_filestat_get": ("i32", "i32"),
+    "fd_filestat_set_size": ("i32", "i64"),
+    "fd_filestat_set_times": ("i32", "i64", "i64", "i32"),
+    "fd_pread": ("i32", "i32", "i32", "i64", "i32"),
+    "fd_pwrite": ("i32", "i32", "i32", "i64", "i32"),
+    "fd_read": ("i32", "i32", "i32", "i32"),
+    "fd_readdir": ("i32", "i32", "i32", "i64", "i32"),
+    "fd_seek": ("i32", "i64", "i32", "i32"),
+    "fd_sync": ("i32",),
+    "fd_tell": ("i32", "i32"),
+    "fd_write": ("i32", "i32", "i32", "i32"),
+    "path_create_directory": ("i32", "i32", "i32"),
+    "path_filestat_get": ("i32", "i32", "i32", "i32", "i32"),
+    "path_filestat_set_times": ("i32", "i32", "i32", "i32", "i64", "i64", "i32"),
+    "path_link": ("i32", "i32", "i32", "i32", "i32", "i32", "i32"),
+    "path_open": ("i32", "i32", "i32", "i32", "i32", "i64", "i64", "i32", "i32"),
+    "path_readlink": ("i32", "i32", "i32", "i32", "i32", "i32"),
+    "path_remove_directory": ("i32", "i32", "i32"),
+    "path_rename": ("i32", "i32", "i32", "i32", "i32", "i32"),
+    "path_symlink": ("i32", "i32", "i32", "i32", "i32"),
+    "path_unlink_file": ("i32", "i32", "i32"),
+}
+
+
+class Errno(enum.IntEnum):
+    """An answer a provider gives instead of a value, in preview1's numbering."""
+
+    EACCES = 2
+    EEXIST = 20
+    EINVAL = 28
+    EIO = 29
+    EISDIR = 31
+    ENOENT = 44
+    ENOTDIR = 54
+    ENOTEMPTY = 55
+    EPERM = 63
+
+
+@dataclass(frozen=True)
+class Stat:
+    """What a provider's `stat` answers: kind "file" or "dir", size and mtime in nanoseconds."""
+
+    kind: str
+    size: int = 0
+    mtime_ns: int = 0
+
+
+@dataclass(frozen=True)
+class Mount:
+    """A provider's files at `guest`, read-only unless `writable`. The three switches are
+    described in the module's docstring."""
+
+    provider: Any
+    guest: str
+    writable: bool = False
+    defer_create: bool = True
+    memo: bool = True
+    stat_reads: bool = False
+    defer_close: bool = False
+
+
+@dataclass
+class _Open:
+    mount: _Mounted
+    path: str
+    kind: str  # "file" or "dir"
+    data: bytes | bytearray = b""
+    position: int = 0
+    append: bool = False
+    writable: bool = False
+    dirty: bool = False
+    listing: bytes | None = None
+    offsets: list[int] = field(default_factory=list)
+
+
+@dataclass
+class _Mounted:
+    mount: Mount
+    number: int  # the preopen's descriptor
+    dev: int
+    pending: dict[str, _Open] = field(default_factory=dict)  # created here, not yet written
+    stats: dict[str, Stat | int] = field(default_factory=dict)
+    bodies: dict[str, bytes] = field(default_factory=dict)
+
+
+def _normal(base: str, text: str) -> str | int:
+    """`text` resolved under the folder `base`, both within the mount, or ENOTCAPABLE when it
+    is absolute or climbs above the mount."""
+    if text.startswith("/"):
+        return ENOTCAPABLE
+    parts = [p for p in base.split("/") if p]
+    for part in text.split("/"):
+        if part in ("", "."):
+            continue
+        if part == "..":
+            if not parts:
+                return ENOTCAPABLE
+            parts.pop()
+        else:
+            parts.append(part)
+    return "/" + "/".join(parts)
+
+
+def _ino(path: str) -> int:
+    return hash(path) & 0xFFFFFFFFFFFF
+
+
+class _Memory:
+    """The guest's memory for one host call, addressed through one base pointer."""
+
+    __slots__ = ("base", "size")
+
+    def __init__(self, caller: Any) -> None:
+        memory = caller.get("memory")
+        self.base = ctypes.cast(memory.data_ptr(caller), ctypes.c_void_p).value or 0
+        self.size = memory.data_len(caller)
+
+    def read(self, ptr: int, length: int) -> bytes:
+        if ptr + length > self.size:
+            raise IndexError("out of bounds")
+        return ctypes.string_at(self.base + ptr, length)
+
+    def write(self, ptr: int, data: bytes) -> None:
+        if ptr + len(data) > self.size:
+            raise IndexError("out of bounds")
+        ctypes.memmove(self.base + ptr, data, len(data))
+
+    def u32(self, ptr: int, value: int) -> None:
+        self.write(ptr, struct.pack("<I", value))
+
+    def iovecs(self, ptr: int, count: int) -> list[tuple[int, int]]:
+        raw = self.read(ptr, 8 * count)
+        return list(struct.iter_unpack("<II", raw))
+
+
+class Table:
+    """One call's mount table: its mounts, open provider files and provider calls."""
+
+    def __init__(self, mounts: list[tuple[Mount, int]]) -> None:
+        self.mounts = {n: _Mounted(m, n, _ino(m.guest)) for m, n in mounts}
+        self.table: dict[int, _Open] = {}
+        for number, mounted in self.mounts.items():
+            self.table[number] = _Open(mounted, "/", "dir")
+        self.next = PROVIDER_BASE
+        self.calls = dict.fromkeys(METHODS, 0)
+        self.forwards: dict[str, Any] = {}
+        self.observer: Callable[..., Any] | None = None
+
+    # Provider calls, counted, with the call's memo in front when the mount keeps one.
+
+    def _invoke(self, mounted: _Mounted, method: str, *args: Any) -> Any:
+        self.calls[method] += 1
+        try:
+            answer = getattr(mounted.mount.provider, method)(*args)
+        except OSError as e:
+            return Errno.EIO if e.errno is None else _errno_of(e)
+        return answer
+
+    def stat(self, mounted: _Mounted, path: str) -> Stat | int:
+        if path in mounted.pending:
+            return Stat("file", len(mounted.pending[path].data))
+        memo = mounted.mount.memo
+        if memo and path in mounted.stats:
+            return mounted.stats[path]
+        if mounted.mount.stat_reads and path != "/":
+            body = self._read(mounted, path)
+            if isinstance(body, (bytes, bytearray)):
+                return mounted.stats.setdefault(path, Stat("file", len(body)))
+            if body != EISDIR:
+                return body
+            answer: Stat | int = Stat("dir")
+        else:
+            got = self._invoke(mounted, "stat", path)
+            answer = int(got) if isinstance(got, Errno) else got
+        if memo:
+            mounted.stats[path] = answer
+        return answer
+
+    def _read(self, mounted: _Mounted, path: str) -> bytes | int:
+        """A file's whole bytes, or an errno (EISDIR for a folder)."""
+        if path in mounted.pending:
+            return bytes(mounted.pending[path].data)
+        if path in mounted.bodies:
+            return mounted.bodies.pop(path) if not mounted.mount.memo else mounted.bodies[path]
+        got = self._invoke(mounted, "read", path)
+        if isinstance(got, Errno):
+            if mounted.mount.memo:
+                mounted.stats[path] = int(got) if got != Errno.EISDIR else Stat("dir")
+            return int(got)
+        body = bytes(got)
+        if mounted.mount.memo or mounted.mount.stat_reads:
+            mounted.bodies[path] = body
+        if mounted.mount.memo:
+            mounted.stats[path] = Stat("file", len(body))
+        return body
+
+    def _list(self, mounted: _Mounted, path: str) -> list[tuple[str, str]] | int:
+        got = self._invoke(mounted, "list", path)
+        if isinstance(got, Errno):
+            return int(got)
+        entries = list(got)
+        prefix = path.rstrip("/") + "/"
+        names = {name for name, _ in entries}
+        for p in mounted.pending:
+            head, _, name = p.rpartition("/")
+            if (head or "/") == path and name not in names:
+                entries.append((name, "file"))
+        if mounted.mount.memo:
+            for name, kind in entries:
+                if kind == "dir":
+                    mounted.stats.setdefault(prefix + name, Stat("dir"))
+        return entries
+
+    def _change(self, mounted: _Mounted, method: str, *args: Any) -> int:
+        got = self._invoke(mounted, method, *args)
+        return int(got) if isinstance(got, Errno) else 0
+
+    def _forget(self, mounted: _Mounted, *paths: str) -> None:
+        for p in paths:
+            mounted.stats.pop(p, None)
+            mounted.bodies.pop(p, None)
+
+    def _write_back(self, entry: _Open) -> int:
+        mounted = entry.mount
+        if not entry.dirty:
+            return 0
+        data = bytes(entry.data)
+        errno = self._change(mounted, "write", entry.path, data)
+        if errno == 0:
+            entry.dirty = False
+            if mounted.pending.get(entry.path) is entry:
+                del mounted.pending[entry.path]
+            if mounted.mount.memo:
+                mounted.stats[entry.path] = Stat("file", len(data))
+                mounted.bodies[entry.path] = data
+            else:
+                self._forget(mounted, entry.path)
+        return errno
+
+    def finish(self) -> None:
+        """The ending's write-backs: every dirty buffer still open or still pending."""
+        seen: set[int] = set()
+        for entry in list(self.table.values()):
+            if entry.kind == "file" and entry.dirty:
+                seen.add(id(entry))
+                self._write_back(entry)
+        for mounted in self.mounts.values():
+            for entry in list(mounted.pending.values()):
+                if id(entry) not in seen:
+                    self._write_back(entry)
+
+    def record(self) -> dict[str, int]:
+        return dict(self.calls)
+
+    # Dispatch.
+
+    def serve(self, name: str, caller: Any, args: tuple[int, ...]) -> int:
+        fd = args[0] & 0xFFFFFFFF
+        if name == "path_rename":
+            if fd in self.table or (args[3] & 0xFFFFFFFF) in self.table:
+                return _path_rename(self, caller, *args)
+            return self.forward(caller, name, args)
+        entry = self.table.get(fd)
+        handler = _HANDLERS.get(name)
+        if entry is None or handler is None or (fd in self.mounts and name in _PREOPEN_OWN):
+            return self.forward(caller, name, args)
+        return handler(self, caller, entry, *args)
+
+    def forward(self, caller: Any, name: str, args: tuple[int, ...]) -> int:
+        return int(self.forwards[name](caller, *args))
+
+    def take(self, entry: _Open) -> int:
+        number = self.next
+        self.next += 1
+        self.table[number] = entry
+        return number
+
+
+# The calls a mount's own preopen forwards to its placeholder folder: what wasi-libc and the
+# guest's table ask of every preopen at the start.
+_PREOPEN_OWN = frozenset({"fd_fdstat_get", "fd_fdstat_set_flags", "fd_filestat_get"})
+
+
+def _errno_of(e: OSError) -> Errno:
+    import errno as host
+
+    name = host.errorcode.get(e.errno or 0, "EIO")
+    return Errno.__members__.get(name, Errno.EIO)
+
+
+def _filestat(mounted: _Mounted, path: str, st: Stat) -> bytes:
+    filetype = DIRECTORY if st.kind == "dir" else REGULAR_FILE
+    size = st.size if st.kind == "file" else 0
+    t = st.mtime_ns
+    return struct.pack(FILESTAT, mounted.dev, _ino(path), filetype, 1, size, t, t, t)
+
+
+# The descriptor calls on a mount's number.
+
+
+def _fd_read(t: Table, caller: Any, e: _Open, fd: int, iovs: int, n: int, out: int) -> int:
+    if e.kind != "file":
+        return EISDIR
+    mem = _Memory(caller)
+    data, pos = e.data, e.position
+    end = len(data)
+    if type(data) is bytes:
+        # Read-only bytes: one copy, from the staged buffer straight into the guest's memory.
+        source = ctypes.cast(ctypes.c_char_p(data), ctypes.c_void_p).value or 0
+    total = 0
+    for buf, size in mem.iovecs(iovs, n):
+        count = min(size, end - pos - total)
+        if count <= 0:
+            break
+        if buf + count > mem.size:
+            raise IndexError("out of bounds")
+        if type(data) is bytes:
+            ctypes.memmove(mem.base + buf, source + pos + total, count)
+        else:
+            mem.write(buf, bytes(data[pos + total : pos + total + count]))
+        total += count
+        if count < size:
+            break
+    e.position = pos + total
+    mem.u32(out, total)
+    return 0
+
+
+def _fd_pread(
+    t: Table, caller: Any, e: _Open, fd: int, iovs: int, n: int, at: int, out: int
+) -> int:
+    saved = e.position
+    e.position = at
+    try:
+        return _fd_read(t, caller, e, fd, iovs, n, out)
+    finally:
+        e.position = saved
+
+
+def _fd_write(t: Table, caller: Any, e: _Open, fd: int, iovs: int, n: int, out: int) -> int:
+    if e.kind != "file" or not e.writable:
+        return EBADF
+    mem = _Memory(caller)
+    if not isinstance(e.data, bytearray):
+        e.data = bytearray(e.data)
+    data = e.data
+    pos = len(data) if e.append else e.position
+    total = 0
+    for buf, size in mem.iovecs(iovs, n):
+        chunk = mem.read(buf, size)
+        if pos > len(data):
+            data.extend(bytes(pos - len(data)))
+        data[pos : pos + size] = chunk
+        pos += size
+        total += size
+    e.position = pos
+    e.dirty = e.dirty or total > 0
+    mem.u32(out, total)
+    return 0
+
+
+def _fd_pwrite(
+    t: Table, caller: Any, e: _Open, fd: int, iovs: int, n: int, at: int, out: int
+) -> int:
+    saved, append = e.position, e.append
+    e.position, e.append = at, False
+    try:
+        return _fd_write(t, caller, e, fd, iovs, n, out)
+    finally:
+        e.position, e.append = saved, append
+
+
+def _fd_seek(t: Table, caller: Any, e: _Open, fd: int, offset: int, whence: int, out: int) -> int:
+    if e.kind != "file":
+        return ESPIPE if e.kind != "dir" else EBADF
+    if offset >= 2**63:
+        offset -= 2**64
+    base = (0, e.position, len(e.data))[whence] if whence in (0, 1, 2) else None
+    if base is None or base + offset < 0:
+        return EINVAL
+    e.position = base + offset
+    struct_out = struct.pack("<Q", e.position)
+    _Memory(caller).write(out, struct_out)
+    return 0
+
+
+def _fd_tell(t: Table, caller: Any, e: _Open, fd: int, out: int) -> int:
+    _Memory(caller).write(out, struct.pack("<Q", e.position))
+    return 0
+
+
+def _fd_close(t: Table, caller: Any, e: _Open, fd: int) -> int:
+    if fd in t.mounts:
+        return 0  # a mount's own preopen stays open, as a grant's does
+    del t.table[fd]
+    if e.kind == "file" and e.dirty:
+        if e.mount.mount.defer_close and e.mount.pending.get(e.path) is e:
+            return 0  # owed: written at the call's end under the name it has then
+        return t._write_back(e)
+    return 0
+
+
+def _fd_sync(t: Table, caller: Any, e: _Open, fd: int) -> int:
+    return t._write_back(e) if e.kind == "file" else 0
+
+
+def _fd_fdstat_get(t: Table, caller: Any, e: _Open, fd: int, out: int) -> int:
+    filetype = DIRECTORY if e.kind == "dir" else REGULAR_FILE
+    rights = RIGHTS if e.writable or e.kind == "dir" else RIGHTS & ~FD_WRITE
+    flags = APPEND if e.append else 0
+    _Memory(caller).write(out, struct.pack(FDSTAT, filetype, flags, rights, RIGHTS))
+    return 0
+
+
+def _fd_fdstat_set_flags(t: Table, caller: Any, e: _Open, fd: int, flags: int) -> int:
+    e.append = bool(flags & APPEND)
+    return 0
+
+
+def _fd_filestat_get(t: Table, caller: Any, e: _Open, fd: int, out: int) -> int:
+    st = Stat(e.kind, len(e.data) if e.kind == "file" else 0)
+    _Memory(caller).write(out, _filestat(e.mount, e.path, st))
+    return 0
+
+
+def _fd_filestat_set_size(t: Table, caller: Any, e: _Open, fd: int, size: int) -> int:
+    if e.kind != "file" or not e.writable:
+        return EBADF
+    if not isinstance(e.data, bytearray):
+        e.data = bytearray(e.data)
+    if size < len(e.data):
+        del e.data[size:]
+    else:
+        e.data.extend(bytes(size - len(e.data)))
+    e.dirty = True
+    return 0
+
+
+def _fd_ok(t: Table, caller: Any, e: _Open, fd: int, *rest: int) -> int:
+    return 0
+
+
+def _fd_readdir(
+    t: Table, caller: Any, e: _Open, fd: int, buf: int, length: int, cookie: int, used: int
+) -> int:
+    if e.kind != "dir":
+        return ENOTDIR
+    if e.listing is None or cookie == 0:
+        entries = t._list(e.mount, e.path)
+        if isinstance(entries, int):
+            return entries
+        data = bytearray()
+        offsets: list[int] = []
+        prefix = e.path.rstrip("/") + "/"
+        named = [(".", "dir"), ("..", "dir"), *entries]
+        for index, (name, kind) in enumerate(named):
+            encoded = name.encode()
+            offsets.append(len(data))
+            d_type = DIRECTORY if kind == "dir" else REGULAR_FILE
+            data += struct.pack(DIRENT, index + 1, _ino(prefix + name), len(encoded), d_type)
+            data += encoded
+        e.listing, e.offsets = bytes(data), offsets
+    mem = _Memory(caller)
+    start = e.offsets[cookie] if cookie < len(e.offsets) else len(e.listing)
+    out = e.listing[start : start + length]
+    mem.write(buf, out)
+    mem.u32(used, len(out))
+    return 0
+
+
+# The path calls under a mount's folder.
+
+
+def _path_text(caller: Any, ptr: int, length: int) -> str:
+    return _Memory(caller).read(ptr, length).decode("utf-8", "surrogateescape")
+
+
+def _resolve(e: _Open, caller: Any, ptr: int, length: int) -> tuple[str, bool] | int:
+    if e.kind != "dir":
+        return ENOTDIR
+    text = _path_text(caller, ptr, length)
+    path = _normal(e.path, text)
+    return (path, text.endswith("/")) if isinstance(path, str) else path
+
+
+def _path_open(
+    t: Table,
+    caller: Any,
+    e: _Open,
+    fd: int,
+    dirflags: int,
+    ptr: int,
+    length: int,
+    oflags: int,
+    base: int,
+    inheriting: int,
+    fdflags: int,
+    out: int,
+) -> int:
+    resolved = _resolve(e, caller, ptr, length)
+    if isinstance(resolved, int):
+        return resolved
