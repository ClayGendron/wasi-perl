+def _path_filestat_get(
+    t: Table, caller: Any, e: _Open, fd: int, flags: int, ptr: int, length: int, out: int
+) -> int:
+    resolved = _resolve(e, caller, ptr, length)
+    if isinstance(resolved, int):
+        return resolved
+    path, folder_only = resolved
+    st = Stat("dir") if path == "/" else t.stat(e.mount, path)
+    if isinstance(st, int):
+        return st
+    if folder_only and st.kind != "dir":
+        return ENOTDIR
+    _Memory(caller).write(out, _filestat(e.mount, path, st))
+    return 0
