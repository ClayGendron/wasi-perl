+def _path_namespace(method: str) -> Callable[..., int]:
+    def handler(t: Table, caller: Any, e: _Open, fd: int, ptr: int, length: int) -> int:
+        resolved = _resolve(e, caller, ptr, length)
+        if isinstance(resolved, int):
+            return resolved
+        path = resolved[0]
+        mounted = e.mount
+        if not mounted.mount.writable:
+            return EROFS
+        if path == "/":
+            return EPERM
+        if method == "remove" and path in mounted.pending:
+            del mounted.pending[path]  # never written: nothing for the provider to remove
+            return 0
+        errno = t._change(mounted, method, path)
+        t._forget(mounted, path)
+        if errno == 0 and mounted.mount.memo and method == "mkdir":
+            mounted.stats[path] = Stat("dir")
+        return errno
+
+    return handler
+
+
+def _path_rename(
+    t: Table, caller: Any, fd: int, op: int, ol: int, nfd: int, np_: int, nl: int
+) -> int:
+    a, b = t.table.get(fd & 0xFFFFFFFF), t.table.get(nfd & 0xFFFFFFFF)
+    if a is None or b is None or a.mount is not b.mount:
+        return EXDEV
+    src = _resolve(a, caller, op, ol)
+    dst = _resolve(b, caller, np_, nl)
+    if isinstance(src, int):
+        return src
+    if isinstance(dst, int):
+        return dst
+    mounted = a.mount
+    if not mounted.mount.writable:
+        return EROFS
+    s, d = src[0], dst[0]
+    if s in mounted.pending:
+        # Created in this call and not yet written: the provider sees only the final name, at
+        # the close. A file the provider holds at the destination is replaced by that write.
+        entry = mounted.pending.pop(s)
+        dropped = mounted.pending.pop(d, None)
+        if dropped is not None:
+            dropped.dirty = False
+        entry.path = d
+        mounted.pending[d] = entry
+        t._forget(mounted, d)
+        return 0
+    errno = t._change(mounted, "rename", s, d)
+    if errno == 0:
+        t._forget(mounted, s, d)
+        for entry in t.table.values():
+            if entry.mount is mounted and entry.path == s:
+                entry.path = d
+    return errno
