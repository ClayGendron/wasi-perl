+class MemoryProvider:
+    """A provider over a dict of path to bytes, with folders implied by the paths. For tests and
+    measurements: `delay_s` sleeps on every call, to stand in for a database round trip."""
+
+    def __init__(self, files: dict[str, bytes], delay_s: float = 0.0) -> None:
+        self.files = dict(files)
+        self.dirs = {"/"}
+        for p in self.files:
+            parts = p.split("/")[1:-1]
+            for i in range(len(parts)):
+                self.dirs.add("/" + "/".join(parts[: i + 1]))
+        self.delay_s = delay_s
+
+    def _wait(self) -> None:
+        if self.delay_s:
+            import time
+
+            time.sleep(self.delay_s)
+
+    def stat(self, path: str) -> Stat | Errno:
+        self._wait()
+        if path in self.dirs:
+            return Stat("dir")
+        if path in self.files:
+            return Stat("file", len(self.files[path]))
+        return Errno.ENOENT
+
+    def list(self, path: str) -> Iterable[tuple[str, str]] | Errno:
+        self._wait()
+        if path not in self.dirs:
+            return Errno.ENOTDIR if path in self.files else Errno.ENOENT
+        prefix = path.rstrip("/") + "/"
+        out: dict[str, str] = {}
+        for p in (*self.files, *self.dirs):
+            if p.startswith(prefix) and p != path:
+                name = p[len(prefix) :].split("/")[0]
+                out.setdefault(name, "dir" if prefix + name in self.dirs else "file")
+        return sorted(out.items())
+
+    def read(self, path: str) -> bytes | Errno:
+        self._wait()
+        if path in self.dirs:
+            return Errno.EISDIR
+        return self.files.get(path, Errno.ENOENT)
+
+    def write(self, path: str, data: bytes) -> None | Errno:
+        self._wait()
+        if path in self.dirs:
+            return Errno.EISDIR
+        self.files[path] = bytes(data)
+        return None
+
+    def mkdir(self, path: str) -> None | Errno:
+        self._wait()
+        if path in self.dirs or path in self.files:
+            return Errno.EEXIST
+        self.dirs.add(path)
+        return None
+
+    def remove(self, path: str) -> None | Errno:
+        self._wait()
+        if path in self.dirs:
+            return Errno.EISDIR
+        if self.files.pop(path, None) is None:
+            return Errno.ENOENT
+        return None
+
+    def rmdir(self, path: str) -> None | Errno:
+        self._wait()
+        if any(p.startswith(path + "/") for p in (*self.files, *self.dirs)):
+            return Errno.ENOTEMPTY
+        self.dirs.discard(path)
+        return None
+
+    def rename(self, src: str, dst: str) -> None | Errno:
+        self._wait()
+        if src not in self.files:
+            return Errno.ENOENT
+        self.files[dst] = self.files.pop(src)
+        return None
