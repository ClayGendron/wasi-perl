+class Forward:
+    """One function of a mount's trampoline, called on the caller's context through
+    `wasmtime_func_call` with its argument array made once and reused, so a forwarded file call
+    costs no `Func.__call__` and touches wasmtime-py's process-wide exception slot not at all.
+    Adapted from wasi-python's `PreparedCall`."""
+
+    __slots__ = ("func", "kinds", "params", "results")
+
+    def __init__(self, func: Any, kinds: tuple[str, ...]) -> None:
+        from wasmtime import _ffi as ffi
+
+        self.func = func._func
+        self.kinds = kinds
+        self.params = (ffi.wasmtime_val_t * len(kinds))()
+        for i, kind in enumerate(kinds):
+            tag = ffi.WASMTIME_I32 if kind == "i32" else ffi.WASMTIME_I64
+            self.params[i].kind = ctypes.c_ubyte(tag.value)
+        self.results = (ffi.wasmtime_val_t * 1)()
+
+    def __call__(self, caller: Any, *args: int) -> int:
+        from wasmtime import Trap, WasmtimeError
+        from wasmtime import _ffi as ffi
+
+        params = self.params
+        for i, value in enumerate(args):
+            if self.kinds[i] == "i32":
+                params[i].of.i32 = value
+            else:
+                params[i].of.i64 = value
+        trap = ctypes.POINTER(ffi.wasm_trap_t)()
+        error = ffi.wasmtime_func_call(
+            caller._context(),
+            ctypes.byref(self.func),
+            params,
+            len(args),
+            self.results,
+            1,
+            ctypes.byref(trap),
+        )
+        if trap:
+            raise Trap._from_ptr(trap)
+        if error:
+            raise WasmtimeError._from_ptr(error)
+        return int(self.results[0].of.i32)
