+class RuntimeFiles:
+    """The runtime's files as one scan found them: every regular file's identity and path, and
+    the stamp of every folder walked. A file is replaced, added or removed only through an entry
+    of its folder, which changes that folder's mtime and ctime, so while every stamp holds, the
+    identities are still the files' own; a second name made elsewhere changes no stamp here, and
+    is found by walking the writable grants, which is done on every call."""
+
+    def __init__(self, tops: Iterable[Path], singles: Iterable[Path]) -> None:
+        stamps: dict[str, Stamp | None] = {}
+        files: dict[Identity, Path] = {}
+
+        def note(path: str) -> None:
+            try:
+                st = os.lstat(path)
+            except OSError:
+                return
+            if stat.S_ISREG(st.st_mode):
+                files.setdefault((st.st_dev, st.st_ino), Path(path))
+
+        # Each folder is stamped before it is listed, so a change after the stamp is seen.
+        pending = [str(top) for top in tops]
+        while pending:
+            folder = pending.pop()
+            if folder in stamps:
+                continue
+            stamps[folder] = _folder_stamp(folder)  # None for one missing: none there
+            try:
+                entries = list(os.scandir(folder))
+            except OSError:
+                continue
+            for entry in entries:
+                if entry.is_dir(follow_symlinks=False):
+                    pending.append(entry.path)
+                else:
+                    note(entry.path)
+        for single in singles:
+            stamps.setdefault(str(single.parent), _folder_stamp(str(single.parent)))
+            note(str(single))
+        self.stamps = tuple(stamps.items())
+        self.files = files
+
