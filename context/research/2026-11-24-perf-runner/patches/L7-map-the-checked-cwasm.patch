+def _fd_name(fd: int) -> str | None:
+    """A name that opens the very file `fd` holds, whatever is at its path now: Linux's
+    /proc/self/fd/N, checked to name that file; None where there is no such name."""
+    if sys.platform != "linux":
+        return None
+    name = f"/proc/self/fd/{fd}"
+    try:
+        named, held = os.stat(name), os.fstat(fd)
+    except OSError:
+        return None
+    return name if (named.st_dev, named.st_ino) == (held.st_dev, held.st_ino) else None
