+/**
+ * \brief Allows blocking file-system operations to run on the calling thread.
+ *
+ * By default each blocking WASI file-system operation is handed to a
+ * background thread and waited for. With `enable` true it runs on the thread
+ * that called into WebAssembly, which avoids two thread wake-ups per call.
+ * See `WasiCtxBuilder::allow_blocking_current_thread` in the Rust API.
+ */
+WASI_API_EXTERN void
+wasi_config_allow_blocking_current_thread(wasi_config_t *config, bool enable);
+
