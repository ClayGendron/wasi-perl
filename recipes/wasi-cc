#!/bin/sh
# The one C compiler for the wasm32-wasip1 build: the pinned wasi-sdk clang with the flags
# every object and every link must share.
#
# - setjmp/longjmp are lowered to WebAssembly exception handling in the standard encoding
#   (-wasm-use-legacy-eh=false); the legacy encoding is refused by the wasmtime we target.
#   Every object must carry the same flags, or the module links but fails at run time.
# - wasi-libc declares signal(), getpid(), times()/clock() and mmap() only behind its
#   _WASI_EMULATED_* switches; the matching libraries are linked at every link.
# - Perl recurses on the C stack, so the linear-memory stack is 8 MiB.
# - clang never runs wasm-opt on the module wasm-ld wrote (--no-wasm-opt), even where one is
#   installed on PATH.
#
# The compiler is always the pinned wasi-sdk under build/tools, whatever the environment says:
# an ambient WASI_SDK, which wasi developers often export, is not read.
here=$(cd "$(dirname "$0")" && pwd)
sdk="$here/../build/tools/wasi-sdk-34.0-x86_64-linux"
sysroot="$sdk/share/wasi-sysroot"
PATH="$sdk/bin:/usr/bin:/bin"
export PATH

link=yes
for a in "$@"; do
    case "$a" in
        -c|-E|-S|-M|-MM) link=no ;;
    esac
done

set -- --target=wasm32-wasip1 --sysroot="$sysroot" \
    -mllvm -wasm-enable-sjlj -mllvm -wasm-use-legacy-eh=false \
    -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID \
    -I"$here/include" -include wasi-perl-libc.h \
    "$@"
# The sandbox refuses processes and signals by standing in for the Perl functions that would
# start or signal one (sandbox-refusals.c): each is wrapped at every link, which changes only a
# link that calls it, and the archive that holds the stand-ins is linked once it is built. A
# perl link without the archive fails on the missing __wrap_ symbols instead of linking quietly.
refusals="$here/../build/stubs/libwasi-perl-refusals.a"
wraps=
for s in Perl_pp_fork Perl_pp_wait Perl_pp_waitpid Perl_pp_alarm Perl_pp_pipe_op Perl_pp_getppid \
    Perl_do_exec3 Perl_do_aexec5 Perl_my_popen Perl_my_popen_list Perl_apply Perl_magic_setsig \
    Perl_my_failure_exit; do
    wraps="$wraps,--wrap=$s"
done
# The guest numbers its own descriptors (wasi-fd-table.c): every wasi-libc function that hands a
# descriptor to the host is wrapped, and so are dup, dup2, dup3 and fcntl, which wasi-libc
# defines to fail. Each __wasi_ function is defined in one wasi-libc object and called from
# others, so the wrap catches every call. Unlike the refusals, these are wrapped in every
# program, so the archive is built before the first link and a link without it fails.
fdtable="$here/../build/stubs/libwasi-perl-fd-table.a"
for s in fd_advise fd_allocate fd_close fd_datasync fd_fdstat_get fd_fdstat_set_flags \
    fd_fdstat_set_rights fd_filestat_get fd_filestat_set_size fd_filestat_set_times fd_pread \
    fd_prestat_dir_name fd_prestat_get fd_pwrite fd_read fd_readdir fd_renumber fd_seek fd_sync \
    fd_tell fd_write path_create_directory path_filestat_get path_filestat_set_times path_link \
    path_open path_readlink path_remove_directory path_rename path_symlink path_unlink_file \
    poll_oneoff sock_accept sock_recv sock_send sock_shutdown; do
    wraps="$wraps,--wrap=__wasi_$s"
done
wraps="$wraps,--wrap=dup,--wrap=dup2,--wrap=dup3,--wrap=fcntl"
if [ "$link" = yes ]; then
    set -- "$@" --no-wasm-opt "-Wl${wraps}" "$fdtable"
    [ -f "$refusals" ] && set -- "$@" "$refusals"
    set -- "$@" -lsetjmp \
        -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-getpid \
        -Wl,-z,stack-size=8388608
fi
exec "$sdk/bin/clang" "$@"
